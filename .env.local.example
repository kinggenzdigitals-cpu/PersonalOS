# Supabase — copy to .env.local and fill in from your project settings
# (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Base URL used for OAuth redirects (defaults to http://localhost:3000 in dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRETS — never prefix these with NEXT_PUBLIC_, or they ship to
# the browser. They are read exclusively from server actions / route handlers.
# ---------------------------------------------------------------------------

# Service-role key. Bypasses RLS — used only by admin server actions and the
# Xendit webhook (src/lib/supabase/admin.ts, which is `server-only`).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Super admin allow-list (comma-separated). These accounts are granted admin at
# the app level AND have their profiles.role promoted to 'super_admin' on first
# sign-in, so the database's is_super_admin() RLS checks agree with the app.
# The address must be CONFIRMED before it grants anything. Leave empty unless
# you mean it — never ship a placeholder address here, or whoever registers it
# becomes a super admin. Promotion is permanent; demote with SQL.
SUPER_ADMIN_EMAILS=

# Xendit billing
XENDIT_SECRET_KEY=your-xendit-secret-key
XENDIT_WEBHOOK_TOKEN=your-xendit-callback-verification-token
